# SuperMonitor binds locally by default. Set 0.0.0.0 only behind a trusted proxy.
SUPMON_LISTEN=127.0.0.1:8080
SUPMON_DATA_DIR=./data
SUPMON_ENVIRONMENT=local

# Required once credential storage is enabled. Generate 32 random bytes and
# inject them with an environment variable or Docker Secret. Never commit it.
SUPMON_MASTER_KEY=
