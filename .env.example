# SuperMonitor binds locally by default. Set 0.0.0.0 only behind a trusted proxy.
SUPMON_LISTEN=127.0.0.1:8080
SUPMON_DATA_DIR=./data
SUPMON_ENVIRONMENT=local

# Whole refresh-wave timeout. Each account also has its own 45-second timeout.
SUPMON_SYNC_TIMEOUT=10m

# Optional outbound HTTP(S) proxy for provider APIs and region-sensitive OAuth,
# for example http://127.0.0.1:7897.
SUPMON_PROXY_URL=

# Logs append to SUPMON_DATA_DIR/supermonitor.log by default. Set "-" only when
# stdout is already persisted by Docker, systemd, or another supervisor.
SUPMON_LOG_FILE=

# Optional for loopback; required for non-loopback listeners. Use at least 24
# random Unicode characters. The browser exchanges it for an HttpOnly session.
SUPMON_ADMIN_TOKEN=

# Dangerous escape hatch for an explicitly isolated outer boundary (for
# example, the provided Docker Compose loopback port binding). Keep false when
# the host port is reachable by other machines.
SUPMON_ALLOW_INSECURE_REMOTE=false

# Optional: required only when an imported Gemini CLI access token expires and
# SuperMonitor must refresh it without asking you to export oauth_creds.json again.
SUPMON_GEMINI_OAUTH_CLIENT_ID=
SUPMON_GEMINI_OAUTH_CLIENT_SECRET=
